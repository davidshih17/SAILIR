# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.ipynb_checkpoints/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Run-time artifacts
logs/
*.log
!results/training_log/train.log
*.pkl
*.npz
*.err
*.out
work-dir/
scratch/

# Per-run output directories — all under results/ except training_log/
results/*/
!results/training_log/

# Generated outputs (regenerable from CSVs in results/)
*.pdf
!**/architecture_diagram.pdf

# Training data is regenerable from data-gen/ and is too big for git
data/
*.jsonl
*.jsonl.gz

# Training output: per-run checkpoints are ignored, EXCEPT the production model
# used by every reduction launcher + the README (committed below).
checkpoints/pentagonbox/
checkpoints/pentagonbox_*/*
checkpoints/*/last.pt
checkpoints/*/checkpoint_epoch*.pt
checkpoints/*/final_model.pt
checkpoints/*/best_model.pt
smoke_checkpoints/
# Production navigation model — referenced as --model-checkpoint everywhere.
!checkpoints/pentagonbox_10x_loop_100/
!checkpoints/pentagonbox_10x_loop_100/best_model.pt

# Compiled extensions and Cython generated C (keep .pyx, not .c/.so)
*.so
sailir/_*_inner.c
sailir/_packed_kernels.c

# In-place backup files from refactor experiments
*.bak-pre-*

# Build artifacts
build/

# External data / orchestrator state (regenerable, large)
from_federica/

# Test scratch dirs inside scripts/symmetries/
scripts/symmetries/tmp_*
scripts/symmetries/logs/

# Build artifacts (replay package tarball)
*.tar.gz
topology_input/fire_tables40_math_All.m
topology_input/*/kira_*/

# Refactor backups. .weightfix_*/pre_refactor.tgz alone is 15 GB -- 95% of
# everything git would otherwise pick up here.
.weightfix_*/
*.bak_*

# Model weights. NOT committed: training now starts FROM SCRATCH (no --resume
# on init.pt), and every .pt is 50-60 MB. Checkpoints move out of band.
*.pt

# EXCEPTION: the gravity3L p=101 from-scratch model, committed so it can be
# evaluated off-site. Must come after the blanket *.pt above -- in gitignore
# the LAST matching rule wins, so a negation placed earlier has no effect.
!checkpoints/gravity3L_p101_scratch/best_model.pt

# Job marker files
.done_*

# DAgger closure regeneration working dirs (rebuildable)
results/truth/closures/regen/
